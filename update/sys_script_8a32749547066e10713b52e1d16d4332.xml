        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var requester = current.sys_created_by;
    var req_sys_id = current.sys_id;

	var userInfo = new GlideRecord('sys_user');
    userInfo.get(requester);
	var magager = userInfo.manager;

    var grREQ = new GlideRecord('sc_req_item');
    grREQ.get(req_sys_id);

    grREQ.watch_list = magager;
	grREQ.update();

})(current, previous);
]]></script>
