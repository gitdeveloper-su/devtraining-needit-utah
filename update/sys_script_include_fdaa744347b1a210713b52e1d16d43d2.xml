        <script><![CDATA[var AjaxForDemo3 = Class.create();
AjaxForDemo3.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    updateItemValue: function() {

        var sysId = this.getParameter('sysparm_sys_id');
        var reqItem = new GlideRecord("sc_req_item");

        if(!reqItem.get(sysId)){
           return "no record";
		}

        var user_name = reqItem.assigned_to;
        var userRecord = new GlideRecord("sys_user");
        userRecord.get(user_name);

        reqItem.u_email = userRecord.email;
        reqItem.update();

        return "success";
    },

    type: 'AjaxForDemo3'
});]]></script>
